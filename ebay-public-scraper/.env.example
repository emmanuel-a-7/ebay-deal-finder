# Copy this file to .env and fill in your values
# .env is gitignored — never commit your actual secrets

# Required: Discord webhook URL for deal alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Optional overrides (can also be set in config.json)
SEARCH_QUERY=nvidia rtx 3060 12gb
MAX_PRICE=250
SCAN_INTERVAL_MINUTES=10
PROJECT_NAME=Deal Hunter
PORT=3060

# Dry run mode — logs alerts to console instead of sending to Discord
DRY_RUN=false
